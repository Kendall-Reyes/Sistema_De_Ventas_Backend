// Schema del esquema `core`.
// Nombres de tablas y columnas en snake_case corregido; los campos Prisma son
// camelCase y se mapean explícitamente con @map / @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Mecanismo de autenticación habilitado para un usuario.
enum AuthProviderProvider {
  GOOGLE @map("google")
  LOCAL  @map("local")

  @@map("auth_provider_provider")
  @@schema("core")
}

/// Estado lógico de un registro que requiere ciclo de vida.
enum Status {
  ACTIVE    @map("active")
  DEACTIVED @map("deactived")

  @@map("status")
  @@schema("core")
}

/// Clasificación del punto de venta por volumen de operación.
enum SalesPointCategory {
  SMALL  @map("small")
  MEDIUM @map("medium")
  LARGE  @map("large")

  @@map("sales_point_category")
  @@schema("core")
}

/// Unidad de medida con la que se comercializa un producto.
enum ProductUnitOfMeasure {
  KILOGRAMS @map("kilograms")
  GRAMS     @map("grams")

  @@map("product_unit_of_measure")
  @@schema("core")
}

/// Forma de pago acordada para un pedido.
enum SalesOrderPaymentMethod {
  CASH   @map("cash")
  CREDIT @map("credit")

  @@map("sales_order_payment_method")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Usuario del sistema (agente de ventas o administrador).
model AppUser {
  id              Int       @id(map: "pk_app_user_id") @default(autoincrement())
  email           String    @unique(map: "uq_app_user_email") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  phone           String?   @db.VarChar(30)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions         Session[]
  authProviders    AuthProvider[]
  salesPoints      SalesPoint[]
  salesTargets     SalesTarget[]
  inventoryReviews SalesPointInventoryReview[]
  salesOrders      SalesOrder[]

  @@map("app_user")
  @@schema("core")
}

/// Credencial o vínculo de identidad externa de un usuario.
model AuthProvider {
  id             Int                  @id(map: "pk_auth_provider_id") @default(autoincrement())
  userId         Int                  @map("user_id")
  provider       AuthProviderProvider
  providerUserId String?              @map("provider_user_id") @db.VarChar(255)
  passwordHash   String?              @map("password_hash") @db.VarChar(255)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_auth_provider_user_id_app_user_id")

  @@unique([userId, provider], map: "uq_auth_provider_user_id_provider")
  @@unique([provider, providerUserId], map: "uq_auth_provider_provider_provider_user_id")
  @@map("auth_provider")
  @@schema("core")
}

/// Sesión de autenticación emitida tras un inicio de sesión exitoso.
model Session {
  id          Int       @id(map: "pk_session_id") @default(autoincrement())
  userId      Int       @map("user_id")
  tokenHash   String    @unique(map: "uq_session_token_hash") @map("token_hash") @db.VarChar(255)
  familyId    String    @default(uuid()) @map("family_id") @db.Uuid
  replaceById Int?      @map("replace_by_id")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user                AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_session_user_id_app_user_id")
  replacedBy          Session?  @relation("SessionReplacement", fields: [replaceById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_session_replace_by_id_session_id")
  replacementSessions Session[] @relation("SessionReplacement")

  @@index([userId], map: "idx_session_user_id")
  @@index([familyId], map: "idx_session_family_id")
  @@index([expiresAt], map: "idx_session_expires_at")
  @@index([replaceById], map: "idx_session_replace_by_id")
  @@map("session")
  @@schema("core")
}

/// Punto de venta atendido por un agente (tienda, puesto o cliente mayorista).
model SalesPoint {
  id           Int                @id(map: "pk_sales_point_id") @default(autoincrement())
  salesAgentId Int                @map("sales_agent_id")
  code         String?            @unique(map: "uq_sales_point_code") @db.VarChar(50)
  name         String             @db.VarChar(150)
  contactName  String?            @map("contact_name") @db.VarChar(150)
  phone        String?            @db.VarChar(30)
  address      String?            @db.Text
  category     SalesPointCategory
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  salesAgent          AppUser                     @relation(fields: [salesAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sales_point_sales_agent_id_app_user_id")
  inventoryReviews    SalesPointInventoryReview[]
  salesOrders         SalesOrder[]
  targetDistributions SalesTargetDistribution[]

  @@index([salesAgentId], map: "idx_sales_point_sales_agent_id")
  @@map("sales_point")
  @@schema("core")
}

/// Meta de venta asignada a un agente para un periodo.
model SalesTarget {
  id           Int       @id(map: "pk_sales_target_id") @default(autoincrement())
  salesAgentId Int       @map("sales_agent_id")
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  targetAmount Decimal   @map("target_amount") @db.Decimal(12, 2)
  status       Status
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  salesAgent    AppUser                   @relation(fields: [salesAgentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sales_target_sales_agent_id_app_user_id")
  distributions SalesTargetDistribution[]

  @@unique([salesAgentId, periodStart], map: "uq_sales_target_sales_agent_id_period_start")
  @@map("sales_target")
  @@schema("core")
}

/// Reparto de una meta de venta entre los puntos de venta del agente.
model SalesTargetDistribution {
  id                     Int       @id(map: "pk_sales_target_distribution_id") @default(autoincrement())
  salesTargetId          Int       @map("sales_target_id")
  salesPointId           Int       @map("sales_point_id")
  distributionPercentage Decimal   @map("distribution_percentage") @db.Decimal(5, 2)
  targetAmount           Decimal   @map("target_amount") @db.Decimal(12, 2)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  salesTarget SalesTarget @relation(fields: [salesTargetId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sales_target_distribution_sales_target_id_sales_target_id")
  salesPoint  SalesPoint  @relation(fields: [salesPointId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sales_target_distribution_sales_point_id_sales_point_id")

  @@unique([salesTargetId, salesPointId], map: "uq_sales_target_distribution_sales_target_id_sales_point_id")
  @@index([salesPointId], map: "idx_sales_target_distribution_sales_point_id")
  @@map("sales_target_distribution")
  @@schema("core")
}

/// Categoría comercial que agrupa productos.
model ProductCategory {
  id          Int       @id(map: "pk_product_category_id") @default(autoincrement())
  name        String    @unique(map: "uq_product_category_name") @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]

  @@map("product_category")
  @@schema("core")
}

/// Tarifa de impuesto configurada (por ejemplo, IVA).
model RateTax {
  id           Int       @id(map: "pk_rate_tax_id") @default(autoincrement())
  haciendaCode String    @unique(map: "uq_rate_tax_hacienda_code") @map("hacienda_code") @db.VarChar(50)
  name         String    @db.VarChar(150)
  percentage   Decimal   @db.Decimal(5, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]

  @@map("rate_tax")
  @@schema("core")
}

/// Producto comercializable del catálogo.
model Product {
  id             Int                  @id(map: "pk_product_id") @default(autoincrement())
  categoryId     Int                  @map("category_id")
  brandId        Int                  @map("brand_id")
  rateTaxId      Int                  @map("rate_tax_id")
  name           String               @db.VarChar(150)
  code           String               @unique(map: "uq_product_code") @db.VarChar(50)
  commercialCode String?              @map("commercial_code") @db.VarChar(50)
  unitOfMeasure  ProductUnitOfMeasure @map("unit_of_measure")
  weight         Decimal              @db.Decimal(10, 3)
  price          Decimal              @db.Decimal(12, 2)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)

  category        ProductCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_product_category_id_product_category_id")
  brand           Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_product_brand_id_brand_id")
  rateTax         RateTax               @relation(fields: [rateTaxId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_product_rate_tax_id_rate_tax_id")
  priceHistory    ProductPriceHistory[]
  productItems    ProductItem[]
  salesOrderItems SalesOrderItem[]

  @@index([categoryId], map: "idx_product_category_id")
  @@index([brandId], map: "idx_product_brand_id")
  @@index([rateTaxId], map: "idx_product_rate_tax_id")
  @@map("product")
  @@schema("core")
}

/// Historial de precios de un producto por vigencia.
model ProductPriceHistory {
  id        Int       @id(map: "pk_product_price_history_id") @default(autoincrement())
  productId Int       @map("product_id")
  price     Decimal   @db.Decimal(12, 2)
  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_price_history_product_id_product_id")

  @@unique([productId, validFrom], map: "uq_product_price_history_product_id_valid_from")
  @@map("product_price_history")
  @@schema("core")
}

/// Empresa propietaria de una o más marcas.
model Company {
  id        Int       @id(map: "pk_company_id") @default(autoincrement())
  code      String    @unique(map: "uq_company_code") @db.VarChar(50)
  name      String    @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  brands Brand[]

  @@map("company")
  @@schema("core")
}

/// Marca comercial que agrupa productos de una empresa.
model Brand {
  id          Int       @id(map: "pk_brand_id") @default(autoincrement())
  companyId   Int       @map("company_id")
  name        String    @db.VarChar(150)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_brand_company_id_company_id")
  products Product[]

  @@unique([companyId, name], map: "uq_brand_company_id_name")
  @@map("brand")
  @@schema("core")
}

/// Revisión de inventario realizada por un agente en un punto de venta.
model SalesPointInventoryReview {
  id           Int       @id(map: "pk_sales_point_inventory_review_id") @default(autoincrement())
  salesPointId Int       @map("sales_point_id")
  salesAgentId Int       @map("sales_agent_id")
  visitAt      DateTime  @default(now()) @map("visit_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  salesPoint   SalesPoint    @relation(fields: [salesPointId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sp_inventory_review_sales_point_id_sales_point_id")
  salesAgent   AppUser       @relation(fields: [salesAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sp_inventory_review_sales_agent_id_app_user_id")
  productItems ProductItem[]
  salesOrders  SalesOrder[]

  @@index([salesPointId], map: "idx_sp_inventory_review_sales_point_id")
  @@index([salesAgentId], map: "idx_sp_inventory_review_sales_agent_id")
  @@map("sales_point_inventory_review")
  @@schema("core")
}

/// Detalle de inventario de un producto dentro de una revisión.
model ProductItem {
  id                  Int       @id(map: "pk_product_item_id") @default(autoincrement())
  inventoryReviewId   Int       @map("inventory_review_id")
  productId           Int       @map("product_id")
  warehouseQuantity   Int       @map("warehouse_quantity")
  shelfQuantity       Int       @map("shelf_quantity")
  displayQuantity     Int       @map("display_quantity")
  recommendedQuantity Int       @map("recommended_quantity")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  inventoryReview SalesPointInventoryReview @relation(fields: [inventoryReviewId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_item_inventory_review_id_sp_inventory_review_id")
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_product_item_product_id_product_id")

  @@unique([inventoryReviewId, productId], map: "uq_product_item_inventory_review_id_product_id")
  @@index([productId], map: "idx_product_item_product_id")
  @@map("product_item")
  @@schema("core")
}

/// Pedido de venta registrado en un punto de venta.
model SalesOrder {
  id                 Int                     @id(map: "pk_sales_order_id") @default(autoincrement())
  salesPointId       Int                     @map("sales_point_id")
  salesAgentId       Int                     @map("sales_agent_id")
  inventoryReviewId  Int?                    @map("inventory_review_id")
  orderNumber        String                  @unique(map: "uq_sales_order_order_number") @map("order_number") @db.VarChar(50)
  orderedAt          DateTime                @map("ordered_at") @db.Timestamptz(6)
  expectedDeliveryAt DateTime?               @map("expected_delivery_at") @db.Timestamptz(6)
  paymentMethod      SalesOrderPaymentMethod @map("payment_method")
  fixedSpaceFee      Decimal?                @map("fixed_space_fee") @db.Decimal(12, 2)
  percentageSpaceFee Decimal?                @map("percentage_space_fee") @db.Decimal(5, 2)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)

  salesPoint      SalesPoint                 @relation(fields: [salesPointId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sales_order_sales_point_id_sales_point_id")
  salesAgent      AppUser                    @relation(fields: [salesAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sales_order_sales_agent_id_app_user_id")
  inventoryReview SalesPointInventoryReview? @relation(fields: [inventoryReviewId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_sales_order_inventory_review_id_sp_inventory_review_id")
  items           SalesOrderItem[]

  @@index([salesPointId], map: "idx_sales_order_sales_point_id")
  @@index([salesAgentId], map: "idx_sales_order_sales_agent_id")
  @@index([inventoryReviewId], map: "idx_sales_order_inventory_review_id")
  @@map("sales_order")
  @@schema("core")
}

/// Línea de pedido: un producto con cantidad, precio y descuento.
model SalesOrderItem {
  id                  Int       @id(map: "pk_sales_order_item_id") @default(autoincrement())
  salesOrderId        Int       @map("sales_order_id")
  productId           Int       @map("product_id")
  quantity            Int
  unitPrice           Decimal   @map("unit_price") @db.Decimal(12, 2)
  unitDiscountedPrice Decimal?  @map("unit_discounted_price") @db.Decimal(12, 2)
  subtotalAmount      Decimal   @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount      Decimal   @map("discount_amount") @db.Decimal(12, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sales_order_item_sales_order_id_sales_order_id")
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_sales_order_item_product_id_product_id")

  @@unique([salesOrderId, productId], map: "uq_sales_order_item_sales_order_id_product_id")
  @@index([productId], map: "idx_sales_order_item_product_id")
  @@map("sales_order_item")
  @@schema("core")
}
